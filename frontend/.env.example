# ==========================================
# DF TaskManager - Frontend Environment Config
# ==========================================

# Backend API base URL
# Leave as http://localhost:5000/api/v1 for local MERN stack
# In Vercel / Render production, update to your backend deployment URL
VITE_API_URL=http://localhost:5000/api/v1

# Default Storage Mode: 'hybrid' (tries backend API first, falls back to localStorage)
# Options: 'hybrid' | 'local_only' | 'cloud_only'
VITE_STORAGE_MODE=hybrid

# Request timeout in milliseconds (slow network handling)
VITE_API_TIMEOUT_MS=8000

# Exponential backoff retry attempts
VITE_API_MAX_RETRIES=3

# Application Title
VITE_APP_TITLE=DF TaskManager
