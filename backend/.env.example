# ==========================================
# DF TaskManager - Backend Environment Config
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
# In production, set this to your deployed frontend domain (e.g., https://df-taskmanager.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Connection String)
# For local development: mongodb://127.0.0.1:27017/df_taskmanager
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/df_taskmanager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/df_taskmanager

# JSON Web Token Secret Keys
JWT_SECRET=df_super_secret_jwt_key_development_change_in_production_9876543210
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
